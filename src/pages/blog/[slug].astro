---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import BudgetDonut from '../../components/BudgetDonut.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Posts with a matching hand-built illustration. Keeps content as plain
// markdown (per README's simple, no-pipeline process) while still
// allowing a supporting visual for specific posts.
const ILLUSTRATIONS: Record<string, 'budget-donut'> = {
  '50-30-20-budget-rule-explained': 'budget-donut',
};
const illustration = ILLUSTRATIONS[post.id];
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {post.data.updatedDate && ` · Updated ${post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}
    </p>
    {illustration === 'budget-donut' && <BudgetDonut />}
    <Content />
    <AdSlot position="in-content" />
  </article>
</BaseLayout>

<style>
  .meta {
    color: #777;
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
</style>
