---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import BudgetDonut from '../../components/BudgetDonut.astro';
import PillarIcon from '../../components/PillarIcon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const samePillar = allPosts.filter((p) => p.id !== post.id && p.data.pillar === post.data.pillar);
const otherPillar = allPosts.filter((p) => p.id !== post.id && p.data.pillar !== post.data.pillar);
const related = [...samePillar, ...otherPillar]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const readingTime = Math.max(1, Math.round(post.body!.split(/\s+/).length / 220));

// Posts with a matching hand-built illustration. Keeps content as plain
// markdown (per README's simple, no-pipeline process) while still
// allowing a supporting visual for specific posts.
const ILLUSTRATIONS: Record<string, 'budget-donut'> = {
  '50-30-20-budget-rule-explained': 'budget-donut',
};
const illustration = ILLUSTRATIONS[post.id];

// Every published post has a matching Pinterest pin image generated by
// scripts/generate-pin.mjs — reuse it as the social/OG preview image
// instead of shipping a separate asset.
const pinImage = `/pins/${post.id}.png`;

// Every published post also has a matching landscape hero banner generated
// by scripts/generate-hero.mjs (public/heroes/<slug>.png) — reuses the same
// palette/pillar icons as the pin, so it's on-brand rather than a stock
// photo. Closes the "every post is a wall of text" gap without adding a
// manual per-post asset step.
const heroImage = `/heroes/${post.id}.png`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(pinImage, Astro.site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'MoneyMattersDaily Editorial',
  },
  publisher: { '@id': `${Astro.site}#organization` },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}/`, Astro.site).toString(),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={pinImage}
  type="article"
  jsonLd={[articleJsonLd]}
>
  <article>
    <p class="pillar-tag">
      <PillarIcon name={post.data.pillar as any} size={14} />
      <a href={`/${post.data.pillar}/`}>{post.data.pillar.replace('-', ' ')}</a>
    </p>
    <h1>{post.data.title}</h1>
    <p class="meta">
      By MoneyMattersDaily Editorial · Published {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}{post.data.updatedDate && ` · Updated ${post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}{' · '}{readingTime} min read
    </p>
    <img
      class="hero-image"
      src={heroImage}
      alt=""
      role="presentation"
      width="1600"
      height="500"
      fetchpriority="high"
    />
    {illustration === 'budget-donut' && <BudgetDonut />}
    <Content />
    <AdSlot position="in-content" />

    {related.length > 0 && (
      <aside class="related">
        <h2>Keep reading</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}/`}>
                <PillarIcon name={r.data.pillar as any} size={15} />
                <span>{r.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .pillar-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1c4a4a;
    background: #e4eeee;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: capitalize;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .pillar-tag a {
    color: inherit;
    text-decoration: none;
  }
  .pillar-tag a:hover {
    text-decoration: underline;
  }
  .meta {
    color: #777;
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 500;
    border-radius: 10px;
    margin: 1.25rem 0 1.75rem;
  }
  article :global(h2) {
    margin-top: 2.25rem;
    padding-left: 0.75rem;
    border-left: 4px solid #1c4a4a;
  }
  article :global(p strong:first-child) {
    color: #1c4a4a;
  }
  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }
  .related h2 {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .related a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .related a svg {
    color: #1c4a4a;
    flex-shrink: 0;
  }
  .related a:hover {
    text-decoration: underline;
  }
</style>
