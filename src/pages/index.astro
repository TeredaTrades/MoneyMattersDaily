---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarIcon from '../components/PillarIcon.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
---

<BaseLayout
  title="Practical Money Guides, Updated Regularly"
  description="Clear, no-jargon guides on budgeting, saving, credit, and investing basics."
>
  <h1>Practical money guides, no jargon</h1>
  <p class="intro">Budgeting, saving, credit, and beginner investing — explained plainly, updated regularly.</p>

  {posts.length > 1 && (
    <>
      <h2 class="section-heading">Browse recent articles</h2>
      <div class="pin-carousel" id="pin-carousel">
        <div class="pin-track">
          {posts.slice(0, 8).map((post) => (
            <a href={`/blog/${post.id}/`} class="pin-slide">
              <img src={`/pins/${post.id}.png`} alt="" loading="lazy" width="1000" height="1500" />
              <span class="pin-slide-title">{post.data.title}</span>
            </a>
          ))}
        </div>
        <div class="pin-dots" role="tablist" aria-label="Carousel slides">
          {posts.slice(0, 8).map((_, i) => (
            <button type="button" class="pin-dot" aria-label={`Go to slide ${i + 1}`} data-index={i}></button>
          ))}
        </div>
      </div>
      <script>
        const root = document.getElementById('pin-carousel');
        if (root) {
          const track = root.querySelector('.pin-track') as HTMLElement;
          const slides = Array.from(root.querySelectorAll('.pin-slide'));
          const dots = Array.from(root.querySelectorAll('.pin-dot')) as HTMLButtonElement[];
          let index = 0;
          let timer: ReturnType<typeof setInterval> | null = null;
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function goTo(i: number) {
            index = (i + slides.length) % slides.length;
            track.style.transform = `translateX(-${index * 100}%)`;
            dots.forEach((d, di) => d.classList.toggle('active', di === index));
          }

          function start() {
            if (prefersReducedMotion) return;
            stop();
            timer = setInterval(() => goTo(index + 1), 4500);
          }
          function stop() {
            if (timer) clearInterval(timer);
            timer = null;
          }

          dots.forEach((dot) => {
            dot.addEventListener('click', () => {
              goTo(Number(dot.dataset.index));
              start();
            });
          });

          root.addEventListener('mouseenter', stop);
          root.addEventListener('mouseleave', start);
          root.addEventListener('focusin', stop);
          root.addEventListener('focusout', start);

          // Basic touch swipe support.
          let touchStartX = 0;
          root.addEventListener('touchstart', (e) => {
            stop();
            touchStartX = e.touches[0].clientX;
          }, { passive: true });
          root.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (dx > 40) goTo(index - 1);
            else if (dx < -40) goTo(index + 1);
            start();
          }, { passive: true });

          goTo(0);
          start();
        }
      </script>
    </>
  )}

  {featured && (
    <a href={`/blog/${featured.id}/`} class="featured-post">
      <span class="featured-tag">
        <PillarIcon name={featured.data.pillar as any} size={16} />
        Latest — {featured.data.pillar.replace('-', ' ')}
      </span>
      <span class="featured-title">{featured.data.title}</span>
      <p class="featured-desc">{featured.data.description}</p>
      <span class="featured-cta">Read the guide →</span>
    </a>
  )}

  {rest.length > 0 && (
    <>
      <h2 class="section-heading">More guides</h2>
      <ul class="post-list">
        {rest.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-icon"><PillarIcon name={post.data.pillar as any} size={18} /></span>
              <span>
                <span class="post-title">{post.data.title}</span>
                <p>{post.data.description}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  .intro {
    color: #555;
  }
  .featured-post {
    display: block;
    margin: 1.5rem 0 2.5rem;
    padding: 1.75rem;
    border: 1px solid #e2e2e2;
    border-left: 4px solid #1c4a4a;
    border-radius: 6px;
    text-decoration: none;
    background: #fafbfc;
  }
  .featured-post:hover {
    border-color: #1c4a4a;
    background: #f5f7fa;
  }
  .featured-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1c4a4a;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .featured-title {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0.6rem 0 0.5rem;
    line-height: 1.3;
  }
  .featured-desc {
    color: #444;
    margin: 0 0 0.9rem;
  }
  .featured-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c4a4a;
  }
  .section-heading {
    font-size: 1.1rem;
    color: #333;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.5rem;
  }
  .pin-carousel {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    margin: 0.6rem 0 1.5rem;
    border: 1px solid #e2e2e2;
  }
  .pin-track {
    display: flex;
    transition: transform 0.4s ease;
  }
  .pin-slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem;
    text-decoration: none;
    background: #fafbfc;
  }
  .pin-slide img {
    flex: 0 0 auto;
    display: block;
    width: 5.5rem;
    height: 3.7rem;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .pin-slide-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: #1a1a1a;
  }
  .pin-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    padding: 0 0 0.55rem;
    background: #fafbfc;
  }
  .pin-dot {
    width: 0.4rem;
    height: 0.4rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #d5d5d5;
    cursor: pointer;
  }
  .pin-dot.active {
    background: #1c4a4a;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }
  .post-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    text-decoration: none;
  }
  .post-icon {
    color: #1c4a4a;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .post-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
  }
  .post-list p {
    margin: 0.25rem 0 0;
    color: #555;
    font-size: 0.95rem;
  }
</style>
