---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarIcon from '../components/PillarIcon.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;

// Carousel always shows the N most recent posts — as new posts are
// published (pubDate desc sort above) they automatically slot in at the
// front and the oldest one ages out. Nothing to update by hand.
const carouselPosts = posts.slice(0, 8);
// Leading/trailing clones of the last/first real slide make the loop
// seamless: the track visually "arrives" at a clone that's identical to
// the real slide, then snaps (transition disabled for one frame) back to
// the real one before continuing — no visible rewind.
const carouselSlides =
  carouselPosts.length > 1
    ? [carouselPosts[carouselPosts.length - 1], ...carouselPosts, carouselPosts[0]]
    : carouselPosts;
---

<BaseLayout
  title="Practical Money Guides, Updated Regularly"
  description="Clear, no-jargon guides on budgeting, saving, credit, and investing basics."
>
  <h1>Practical money guides, no jargon</h1>
  <p class="intro">Budgeting, saving, credit, and beginner investing — explained plainly, updated regularly.</p>

  {posts.length > 1 && (
    <>
      <h2 class="section-heading">Browse recent articles</h2>
      <div class="pin-carousel" id="pin-carousel">
        <div class="pin-track" id="pin-track">
          {carouselSlides.map((post, i) => {
            const isClone = i === 0 || i === carouselSlides.length - 1;
            return (
              <a
                href={`/blog/${post.id}/`}
                class="pin-slide"
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <img src={`/pins/${post.id}.png`} alt="" loading="lazy" width="1000" height="1500" />
                <span class="pin-slide-title">{post.data.title}</span>
              </a>
            );
          })}
        </div>
        <div class="pin-dots" role="tablist" aria-label="Carousel slides">
          {carouselPosts.map((_, i) => (
            <button type="button" class="pin-dot" aria-label={`Go to slide ${i + 1}`} data-index={i}></button>
          ))}
        </div>
      </div>
      <script>
        const root = document.getElementById('pin-carousel');
        if (root) {
          const track = document.getElementById('pin-track') as HTMLElement;
          const dots = Array.from(root.querySelectorAll('.pin-dot')) as HTMLButtonElement[];
          const realCount = dots.length;
          const hasClones = realCount > 1;
          // With clones, real slide 0 sits at track index 1 (index 0 is the
          // trailing clone of the last slide).
          let index = hasClones ? 1 : 0;
          let timer: ReturnType<typeof setInterval> | null = null;
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function setActiveDot() {
            const realIndex = hasClones ? (index - 1 + realCount) % realCount : index;
            dots.forEach((d, di) => d.classList.toggle('active', di === realIndex));
          }

          function goTo(i: number, animate = true) {
            index = i;
            if (animate) {
              track.style.transform = `translateX(-${index * 100}%)`;
            } else {
              track.style.transition = 'none';
              track.style.transform = `translateX(-${index * 100}%)`;
              // Force a reflow so the jump applies before transitions resume.
              void track.offsetHeight;
              track.style.transition = '';
            }
            setActiveDot();
          }

          // After the track finishes animating onto a clone slide, jump
          // instantly (no transition) to the matching real slide.
          track.addEventListener('transitionend', () => {
            if (!hasClones) return;
            if (index === realCount + 1) {
              requestAnimationFrame(() => goTo(1, false));
            } else if (index === 0) {
              requestAnimationFrame(() => goTo(realCount, false));
            }
          });

          function next() {
            goTo(index + 1);
          }
          function prev() {
            goTo(index - 1);
          }

          function start() {
            if (prefersReducedMotion) return;
            stop();
            timer = setInterval(next, 4500);
          }
          function stop() {
            if (timer) clearInterval(timer);
            timer = null;
          }

          dots.forEach((dot) => {
            dot.addEventListener('click', () => {
              const realIndex = Number(dot.dataset.index);
              goTo(hasClones ? realIndex + 1 : realIndex);
              start();
            });
          });

          root.addEventListener('mouseenter', stop);
          root.addEventListener('mouseleave', start);
          root.addEventListener('focusin', stop);
          root.addEventListener('focusout', start);

          // Basic touch swipe support.
          let touchStartX = 0;
          root.addEventListener('touchstart', (e) => {
            stop();
            touchStartX = e.touches[0].clientX;
          }, { passive: true });
          root.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (dx > 40) prev();
            else if (dx < -40) next();
            start();
          }, { passive: true });

          goTo(index, false);
          start();
        }
      </script>
    </>
  )}

  {featured && (
    <a href={`/blog/${featured.id}/`} class="featured-post">
      <span class="featured-tag">
        <PillarIcon name={featured.data.pillar as any} size={16} />
        Latest — {featured.data.pillar.replace('-', ' ')}
      </span>
      <span class="featured-title">{featured.data.title}</span>
      <p class="featured-desc">{featured.data.description}</p>
      <span class="featured-cta">Read the guide →</span>
    </a>
  )}

  {rest.length > 0 && (
    <>
      <h2 class="section-heading">More guides</h2>
      <ul class="post-list">
        {rest.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-icon"><PillarIcon name={post.data.pillar as any} size={18} /></span>
              <span>
                <span class="post-title">{post.data.title}</span>
                <p>{post.data.description}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  .intro {
    color: #555;
  }
  .featured-post {
    display: block;
    margin: 1.5rem 0 2.5rem;
    padding: 1.75rem;
    border: 1px solid #e2e2e2;
    border-left: 4px solid #1c4a4a;
    border-radius: 6px;
    text-decoration: none;
    background: #fafbfc;
  }
  .featured-post:hover {
    border-color: #1c4a4a;
    background: #f5f7fa;
  }
  .featured-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1c4a4a;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .featured-title {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0.6rem 0 0.5rem;
    line-height: 1.3;
  }
  .featured-desc {
    color: #444;
    margin: 0 0 0.9rem;
  }
  .featured-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c4a4a;
  }
  .section-heading {
    font-size: 1.1rem;
    color: #333;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.5rem;
  }
  .pin-carousel {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    margin: 0.6rem 0 1.5rem;
    border: 1px solid #e2e2e2;
  }
  .pin-track {
    display: flex;
    transition: transform 0.4s ease;
  }
  .pin-slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem;
    text-decoration: none;
    background: #fafbfc;
  }
  .pin-slide img {
    flex: 0 0 auto;
    display: block;
    width: 7rem;
    height: 4.7rem;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .pin-slide-title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: #1a1a1a;
  }
  .pin-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    padding: 0 0 0.55rem;
    background: #fafbfc;
  }
  .pin-dot {
    width: 0.4rem;
    height: 0.4rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #d5d5d5;
    cursor: pointer;
  }
  .pin-dot.active {
    background: #1c4a4a;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }
  .post-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    text-decoration: none;
  }
  .post-icon {
    color: #1c4a4a;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .post-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
  }
  .post-list p {
    margin: 0.25rem 0 0;
    color: #555;
    font-size: 0.95rem;
  }
</style>
