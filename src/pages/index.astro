---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarIcon from '../components/PillarIcon.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
---

<BaseLayout
  title="Practical Money Guides, Updated Regularly"
  description="Clear, no-jargon guides on budgeting, saving, credit, and investing basics."
>
  <h1>Practical money guides, no jargon</h1>
  <p class="intro">Budgeting, saving, credit, and beginner investing — explained plainly, updated regularly.</p>

  {posts.length > 1 && (
    <>
      <h2 class="section-heading">Browse recent articles</h2>
      <ul class="pin-carousel">
        {posts.slice(0, 12).map((post) => (
          <li class="pin-card">
            <a href={`/blog/${post.id}/`}>
              <img src={`/pins/${post.id}.png`} alt="" loading="lazy" width="1000" height="1500" />
              <span>{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  {featured && (
    <a href={`/blog/${featured.id}/`} class="featured-post">
      <span class="featured-tag">
        <PillarIcon name={featured.data.pillar as any} size={16} />
        Latest — {featured.data.pillar.replace('-', ' ')}
      </span>
      <span class="featured-title">{featured.data.title}</span>
      <p class="featured-desc">{featured.data.description}</p>
      <span class="featured-cta">Read the guide →</span>
    </a>
  )}

  {rest.length > 0 && (
    <>
      <h2 class="section-heading">More guides</h2>
      <ul class="post-list">
        {rest.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-icon"><PillarIcon name={post.data.pillar as any} size={18} /></span>
              <span>
                <span class="post-title">{post.data.title}</span>
                <p>{post.data.description}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  .intro {
    color: #555;
  }
  .featured-post {
    display: block;
    margin: 1.5rem 0 2.5rem;
    padding: 1.75rem;
    border: 1px solid #e2e2e2;
    border-left: 4px solid #1c4a4a;
    border-radius: 6px;
    text-decoration: none;
    background: #fafbfc;
  }
  .featured-post:hover {
    border-color: #1c4a4a;
    background: #f5f7fa;
  }
  .featured-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1c4a4a;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .featured-title {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0.6rem 0 0.5rem;
    line-height: 1.3;
  }
  .featured-desc {
    color: #444;
    margin: 0 0 0.9rem;
  }
  .featured-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c4a4a;
  }
  .section-heading {
    font-size: 1.1rem;
    color: #333;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.5rem;
  }
  .pin-carousel {
    list-style: none;
    display: flex;
    gap: 0.9rem;
    padding: 0.25rem 0 1rem;
    margin: 0.75rem 0 1.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .pin-card {
    flex: 0 0 auto;
    width: 6.5rem;
    scroll-snap-align: start;
  }
  .pin-card a {
    display: block;
    text-decoration: none;
  }
  .pin-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1000 / 1500;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .pin-card span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.4rem;
    font-size: 0.78rem;
    line-height: 1.25;
    color: #333;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }
  .post-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    text-decoration: none;
  }
  .post-icon {
    color: #1c4a4a;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .post-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
  }
  .post-list p {
    margin: 0.25rem 0 0;
    color: #555;
    font-size: 0.95rem;
  }
</style>
