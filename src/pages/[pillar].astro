---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarIcon from '../components/PillarIcon.astro';

export async function getStaticPaths() {
  return [
    'budgeting',
    'saving',
    'credit',
    'investing-basics',
    'app-comparisons',
    'travel-finance',
    'news-trends',
  ].map((pillar) => ({ params: { pillar } }));
}

const PILLARS: Record<string, string> = {
  budgeting: 'Budgeting',
  saving: 'Saving',
  credit: 'Credit',
  'investing-basics': 'Investing Basics',
  'app-comparisons': 'App Comparisons',
  'travel-finance': 'Travel & Nomad Finances',
  'news-trends': 'News & Trends',
};

const { pillar } = Astro.params as { pillar: string };
const label = PILLARS[pillar];

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.pillar === pillar);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={label} description={`${label} guides on MoneyMattersDaily.`}>
  <h1 class="pillar-heading"><PillarIcon name={pillar as any} size={30} /> {label}</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p>No posts in this pillar yet — check back soon.</p>}
</BaseLayout>

<style>
  .pillar-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .pillar-heading svg {
    color: #1c4a4a;
    flex-shrink: 0;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }
  .post-list a {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
  }
  .post-list p {
    margin: 0.25rem 0 0;
    color: #555;
    font-size: 0.95rem;
  }
</style>
