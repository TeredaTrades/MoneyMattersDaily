---
import AdSlot from '../components/AdSlot.astro';
import PillarIcon from '../components/PillarIcon.astro';

interface Props {
  title: string;
  description: string;
  // Root-relative path to a preview image (e.g. a post's Pinterest pin).
  // Falls back to no og:image/twitter:image if omitted.
  image?: string;
  // 'website' (default) or 'article' for blog posts — feeds og:type.
  type?: 'website' | 'article';
  // Extra JSON-LD blocks for this specific page (e.g. an Article schema on
  // blog posts). Always merged with the site-wide Organization/WebSite
  // schema below, so callers only need to pass page-specific data.
  jsonLd?: Record<string, unknown>[];
}
const { title, description, image, type = 'website', jsonLd = [] } = Astro.props;
const siteName = 'MoneyMattersDaily';

// Astro.site is set via `site:` in astro.config.mjs, so this resolves to a
// real absolute URL both locally and in production — no hardcoded domain.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site).toString() : undefined;

// Site-wide structured data — present on every page so crawlers (search
// and AI alike) have a stable anchor for "who publishes this site" instead
// of having to infer it from prose.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#organization`,
      name: siteName,
      url: Astro.site?.toString(),
      logo: new URL('/favicon.svg', Astro.site).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: siteName,
      url: Astro.site?.toString(),
      publisher: { '@id': `${Astro.site}#organization` },
    },
  ],
};

const structuredData = [siteSchema, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    <link rel="icon" href="/favicon.svg" />

    {structuredData.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo">{siteName}</a>
      <nav>
        <a href="/budgeting"><PillarIcon name="budgeting" size={15} /> Budgeting</a>
        <a href="/saving"><PillarIcon name="saving" size={15} /> Saving</a>
        <a href="/credit"><PillarIcon name="credit" size={15} /> Credit</a>
        <a href="/investing-basics"><PillarIcon name="investing-basics" size={15} /> Investing Basics</a>
        <a href="/app-comparisons"><PillarIcon name="app-comparisons" size={15} /> App Comparisons</a>
        <a href="/travel-finance"><PillarIcon name="travel-finance" size={15} /> Travel & Nomad Finances</a>
        <a href="/news-trends"><PillarIcon name="news-trends" size={15} /> News & Trends</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <AdSlot position="header" />

    <main>
      <slot />
    </main>

    <AdSlot position="footer" />

    <footer class="site-footer">
      <nav class="footer-links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/disclaimer">Disclaimer &amp; Privacy</a>
        <a href="https://twitter.com/moneymattersdly" rel="noopener">Twitter</a>
        <a href="https://pinterest.com/moneymattersdaily" rel="noopener">Pinterest</a>
      </nav>
      <p>&copy; {new Date().getFullYear()} {siteName}. Informational content only — not financial advice.</p>
    </footer>

    <style is:global>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 42rem;
        margin: 0 auto;
        padding: 0 1.25rem;
        line-height: 1.6;
        color: #1a1a1a;
        --accent: #1c4a4a;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1.5rem 0;
        border-bottom: 2px solid #1c4a4a;
      }
      .site-logo {
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--accent);
      }
      .site-header nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.9rem;
      }
      .site-header nav a {
        color: #444;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .site-header nav a svg {
        color: #5b8a8a;
        flex-shrink: 0;
      }
      .site-header nav a:hover svg {
        color: var(--accent);
      }
      .site-header nav a:hover {
        color: var(--accent);
      }
      .site-footer {
        margin-top: 3rem;
        padding: 1.5rem 0;
        border-top: 1px solid #eee;
        font-size: 0.85rem;
        color: #777;
      }
      .footer-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
      }
      .footer-links a {
        color: #555;
        text-decoration: none;
      }
      .footer-links a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
